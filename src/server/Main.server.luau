--!strict
--[[
	서버 진입점 (ServerScriptService.Server.Main — Script, RunContext = Server)
	팀 표준: 진입점은 이것 하나. 나머지는 전부 ModuleScript + start().
	시작 순서가 중요합니다 (위에서 아래로). CycleService.run() 은 모두가 구독한 뒤 맨 마지막.
	특수 장소 서비스(사쿠라 나무)는 MapBuilder 다음이어야 함 (맵에 파트가 없으면 임시 파트를 만듦).
	5판: 퀘스트(QuestService)·무료 보상(RewardService.start) 없앰. TutorialService 는 BaseService·PetService 뒤
	     (그 신호에 연결), LeaderboardService(10초마다 랭킹판) 추가.
	6판 "씨앗을 훔치세요": PlantVisualService(선임: 씨앗 단계·성체 식물 모양) 추가. FruitService(열매 맺기·따기·팔기·먹이기) 추가 — TutorialService 가 그 신호에 연결하므로 그보다 먼저.
	     없앤 것: IncomeService(자동 수입), RewardService(오프라인 수입), FusionService(퓨전 머신), AltarService(제단·비밀 통로)
]]

local Server = script.Parent
local Services = Server.Services

local Net = require(Server.Net)
local MapBuilder = require(Services.MapBuilder)
local PetVisualService = require(Services.PetVisualService)
local EggVisualService = require(Services.EggVisualService)
local PlantVisualService = require(Services.PlantVisualService)
local DataService = require(Services.DataService)
local AntiCheatService = require(Services.AntiCheatService)
local SpeedService = require(Services.SpeedService)
local CycleService = require(Services.CycleService)
local EggService = require(Services.EggService)
local GuardianService = require(Services.GuardianService)
local PetService = require(Services.PetService)
local IndexService = require(Services.IndexService)
local FruitService = require(Services.FruitService)
local BaseService = require(Services.BaseService)
local TutorialService = require(Services.TutorialService)
local UpgradeService = require(Services.UpgradeService)
local TreadmillService = require(Services.TreadmillService)
local ToolService = require(Services.ToolService)
local SakuraService = require(Services.SakuraService)
local LeaderboardService = require(Services.LeaderboardService)
local DevCommands = require(Services.DevCommands)
local PlayerLifecycle = require(Services.PlayerLifecycle)

-- 서비스 하나의 start() 가 오류를 내도 나머지는 계속 켜지게 (오류는 출력창에 warn)
local failed: { string } = {}
local function boot(name: string, fn: () -> ...any)
	local ok, err = pcall(fn)
	if not ok then
		table.insert(failed, name)
		warn("[StealAnEgg] " .. name .. " 시작 실패: " .. tostring(err))
	end
end

boot("Net", function()
	Net.start()
end)
boot("MapBuilder", function()
	MapBuilder.start()
end)
boot("PetVisualService", function()
	PetVisualService.start()
end)
boot("EggVisualService", function()
	EggVisualService.start()
end)
boot("PlantVisualService", function()
	PlantVisualService.start()
end)
boot("DataService", function()
	DataService.start()
end)
boot("AntiCheatService", function()
	AntiCheatService.start()
end)
boot("SpeedService", function()
	SpeedService.start()
end)
boot("CycleService", function()
	CycleService.start()
end)
boot("EggService", function()
	EggService.start()
end)
boot("GuardianService", function()
	GuardianService.start()
end)
boot("PetService", function()
	PetService.start()
end)
boot("IndexService", function()
	IndexService.start()
end)
boot("FruitService", function()
	FruitService.start()
end)
boot("BaseService", function()
	BaseService.start()
end)
boot("TutorialService", function()
	TutorialService.start()
end)
boot("UpgradeService", function()
	UpgradeService.start()
end)
boot("TreadmillService", function()
	TreadmillService.start()
end)
boot("ToolService", function()
	ToolService.start()
end)
boot("SakuraService", function()
	SakuraService.start()
end)
boot("LeaderboardService", function()
	LeaderboardService.start()
end)
boot("DevCommands", function()
	DevCommands.start()
end)
boot("PlayerLifecycle", function()
	PlayerLifecycle.start()
end)
boot("CycleService.run", function()
	CycleService.run()
end)

if #failed == 0 then
	print("[StealAnEgg] 서버 시작 완료")
else
	warn("[StealAnEgg] 서버 시작 — 일부 실패: " .. table.concat(failed, ", "))
end
